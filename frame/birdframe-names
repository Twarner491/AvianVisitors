#!/usr/bin/env bash
# Bird names on the e-ink frame.
#
#   birdframe-names auto     follow the station (the default): set it once on
#                            the mic Pi, in the web admin under Bird names
#   birdframe-names on|off   override on this frame only
#   birdframe-names status   what is in effect, and why

set -euo pipefail
umask 077

usage() {
  echo "usage: birdframe-names auto|on|off|status" >&2
  exit 2
}

action=${1:-}
case "$action" in
  on) value=true ;;
  off) value=false ;;
  # "" is the only spelling of "unset" that is both valid TOML and what
  # display.py reads as follow. A bare word would crash every timer tick.
  auto) value='""' ;;
  status) ;;
  *) usage ;;
esac

config=${BIRDFRAME_CONFIG:-$HOME/.birdframe/config.toml}
[ -f "$config" ] || { echo "bird frame is not installed: $config is missing" >&2; exit 1; }

conf_value() {
  awk -F= -v key="$1" '
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      v=$0; sub(/^[^=]*=/, "", v); sub(/[[:space:]]*#.*$/, "", v); gsub(/^[[:space:]"]+|[[:space:]"]+$/, "", v); print v; exit
    }' "$config"
}
current=$(conf_value bird_names)
image_url=$(conf_value image_url)
source_kind=$(conf_value species_source)
case "${current,,}" in
  true|on|1|yes) current=on ;;
  false|off|0|no) current=off ;;
  *) current=auto ;;
esac

if [ "$action" = status ]; then
  if [ "$current" = auto ] && [ "$source_kind" = birdweather ]; then
    echo "auto (names on: a BirdWeather frame has no station to follow)"
  elif [ "$current" = auto ]; then
    echo "auto (following the station's COLLAGE_LABELS)"
  else
    echo "$current (this frame overrides the station)"
  fi
  exit 0
fi

# A published frame is drawn by the mic Pi, which serves one image and ignores
# ?labels=. An override here would print success and change nothing, so say
# where the setting actually lives instead of pretending.
if [ "$action" != auto ] && [ -n "$image_url" ]; then
  echo "This frame shows a pre-rendered image from" >&2
  echo "  $image_url" >&2
  echo "so names are decided where it is rendered. On the mic Pi, open the web" >&2
  echo "admin and set Bird names, or edit COLLAGE_LABELS in birdnet.conf." >&2
  echo "Use 'birdframe-names auto' to follow it." >&2
  exit 1
fi

if [ "$current" = "$action" ] || { [ "$action" = auto ] && [ "$current" = auto ]; }; then
  echo "bird names already $action"
  exit 0
fi

tmp=$(mktemp "${config}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
awk -v value="$value" '
  BEGIN { found=0 }
  /^[[:space:]]*bird_names[[:space:]]*=/ {
    print "bird_names = " value; found=1; next
  }
  { print }
  END { if (!found) print "bird_names = " value }
' "$config" >"$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$config"
trap - EXIT

script_path=${BASH_SOURCE[0]}
for _ in 1 2 3 4 5; do
  [ -L "$script_path" ] || break
  script_dir=$(cd -P "$(dirname "$script_path")" && pwd)
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path=$script_dir/$link_target ;;
  esac
done
[ ! -L "$script_path" ] || { echo "could not resolve the birdframe-names command" >&2; exit 1; }
frame_dir=$(cd -P "$(dirname "$script_path")" && pwd)
python_bin="$frame_dir/.venv/bin/python"
[ -x "$python_bin" ] || { echo "frame environment is missing: $python_bin" >&2; exit 1; }
"$python_bin" "$frame_dir/display.py" --config "$config" --force
echo "bird names $action"
