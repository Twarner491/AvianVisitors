[Unit]
Description=Update the e-ink bird frame on a schedule

[Timer]
# Give every timer activation its own bootstrap deadline. A persistent timer
# remembers that its earlier OnBootSec deadline fired, while OnUnitActiveSec
# depends on the service's in-memory activation time. If both units are stopped
# and later unloaded, restarting the timer can otherwise leave no next deadline.
OnActiveSec=2min
OnBootSec=2min
# Absolute schedule, not OnUnitActiveSec: the latter counts from the service's
# last activation, so if the OnBootSec shot is ever missed the timer has nothing
# to count from, reports Trigger=n/a, and never fires again. OnCalendar always
# has a next elapse regardless of whether the service has ever run.
OnCalendar=*:0/15
Persistent=true

[Install]
WantedBy=timers.target
